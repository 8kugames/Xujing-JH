# ============================================================================
# Xujing-JH Agent 配置模板
# ============================================================================
#
# 首次启动时，Agent 会自动：
#   1. 生成 device_id（如果为 null）
#   2. 向服务器注册获取 auth_token（如果为 null）
#   3. 保存完整配置到 agent.yaml
#
# 使用方式：
#   cp agent.yaml.example agent.yaml
#   # 编辑 server.ws_url 和 server.http_url 为实际服务器地址
#   docker compose up -d
#
# ============================================================================

identity:
  # 设备唯一标识（首次启动自动生成）
  device_id: null
  # 认证令牌（首次启动自动向服务器注册获取）
  auth_token: null

server:
  # 游戏服务器 WebSocket 地址
  # 开发环境: ws://localhost:23333/ws
  # 生产环境: wss://your-server.com/ws
  ws_url: ws://your-server-host:23333/ws
  # 游戏服务器 HTTP 地址
  http_url: http://your-server-host:23333

runtime:
  # 运行模式: claw (HTTP API 供外部调用) | cognitive (内置 AI 决策)
  mode: claw
  # HTTP API 端口（容器内固定 23340）
  port: 23340

memory:
  # 是否启用记忆系统
  enabled: true
  # 工作记忆容量
  working_memory_size: 20
  # 情节记忆阈值
  episodic_threshold: 0.5
  # 数据库路径（null 使用默认路径）
  db_path: null

# 角色类型: player | npc
role: player

# 玩家侧意图决策模型（两段式：人魂 LLM 出认知 -> 2B 决策模型出结构化意图 -> 天魂审查不变）
# 默认开启；模型未就绪/调用失败自动回退既有"人魂 LLM 直接写 actions JSON"路径。
# 两个下载源均留空时功能不装配（一次性告警，走既有路径）；不想用本功能置 enabled: false。
decision_model:
  # 总开关（默认 true；用户可主动关闭）
  enabled: true
  # 部署模式：local = 下载自启动（本地缺省）；remote = URL 访问已部署端点
  # （docker 唯一允许；容器内缺省用发现地址 http://decision-model:8081）
  # mode: remote
  # remote_url: http://decision-model:8081
  # remote_api_key: sk-xxx    # 端点鉴权（可选）
  # remote_model: my-gateway/decision-2b  # 多模型网关路由名（llama.app serve / llama-swap
  #                                        # 的 preset id；单模型 llama-server 留空）
  # ModelScope 模型仓（主下载源；默认官方发布仓，含 manifest.json + gguf + decision_config.json）
  modelscope_repo: "8kugames/Cyber-Jianghu-Decision-2B"
  # GitHub Releases 下载基址（备源；latest/download/<file> 兜底，置空串禁用该源）
  github_release_url: "https://github.com/8kugames/Cyber-Jianghu-Decision-2B/releases"
  # 量化档位: q8_0 | q6_k | q5_k_m | q4_k_s（默认 q5_k_m）
  quant: q5_k_m
  # 置信度门控阈值：act1 confidence >= 阈值才采用决策输出，否则回退 LLM 决策路径
  threshold: 0.70
  # 单次决策调用超时（毫秒）；超时/失败一律回退既有路径，不影响 agent 存活
  timeout_ms: 30000
  # 模型安装目录（null = ~/.cyber-jianghu/decision-model/；版本子目录 model-v1/，current.json 记录当前版本）
  install_dir: null
  # 低配自动降档：系统可用内存（MB）低于此值时改用 q4_k_s（0 = 关闭）
  low_memory_threshold_mb: 6144
  # llama-server 可执行文件（null = 自动从分发仓按平台下载并解压，推荐；
  # 显式路径则跳过自动装配。PATH 中的 llama-server 仅作最后兜底）
  llama_server_path: null
  # llama-server 端口（0 = 自动选择空闲端口）
  port: 0
  # llama-server 附加参数（如 ["-ngl", "99"] 开 GPU 卸载）
  llama_server_args: []
  # llama-server 启动 + 模型加载超时（毫秒）
  startup_timeout_ms: 180000

# 角色生成配置（schema-driven，prompt 和 validate 共享同一约束定义）
character_generation:
  world_setting: "时代：武侠架空世界，冷兵器时代。世界使用独立\"天道历\"纪年，与现实朝代无关。允许的概念：内力、轻功、武功、点穴，暗器、毒术、医术、易容、阵法。禁止的概念：魔法、仙术、法术、热武器、现代科技、超能力、穿越。"
  fields:
    - path: name
      type: string
      required: true
      min_chars: 2
      max_chars: 20
      prompt_text: "plain/realistic Chinese name (NOT Wuxia/martial-arts style, must be original), {min_chars}-{max_chars} chars, {surname_constraint}"
    - path: age
      type: integer
      required: true
      min: 16
      max: 60
    - path: gender
      type: enum
      required: true
      options: ["男", "女"]
    - path: appearance
      type: string
      required: false
      min_chars: 20
      max_chars: 100
      prompt_text: "appearance ({min_chars}-{max_chars} chars), distinctive"
    - path: identity
      type: string
      required: false
      max_chars: 300
      prompt_text: "background (max {max_chars} chars), unique story"
    - path: personality
      type: enum_array
      required: true
      options: ["豪爽", "沉稳", "机智", "冷漠", "善良", "阴险", "正义", "贪婪", "忠诚", "狡猾"]
      min_count: 2
      max_count: 4
      extra_prompt: "avoid all-positive or all-negative, match background"
    - path: values
      type: enum_array
      required: true
      options: ["侠义", "财富", "权力", "自由", "荣誉", "知识", "爱情", "友情", "复仇", "和平"]
      min_count: 1
      max_count: 3
      extra_prompt: "match background"
    - path: language_style.tone
      type: enum
      required: true
      options: ["豪迈", "温和", "冷漠", "狡黠", "文雅"]
    - path: language_style.speech_patterns
      type: enum_array
      required: true
      options: ["喜欢引用古诗词", "说话简洁", "喜欢用成语", "说话带方言", "喜欢开玩笑", "说话谨慎"]
      min_count: 1
      max_count: 3
    - path: goals.short_term
      type: string
      required: false
      max_chars: 100
      prompt_text: "short-term goal (max {max_chars} chars), specific and personal"
    - path: goals.long_term
      type: string
      required: false
      max_chars: 100
      prompt_text: "long-term goal (max {max_chars} chars), ambitious"

# ── LLM 主/从分流（可选，设置页「场景分流」与「从模型」卡片同一通道）─────────
# llm_secondary: 从模型（轻量路由目标）。省略 = 与主模型一致（动态跟随）；
# 显式定义 = 可跨 Provider 完整重写（provider/base_url/api_key/model 均可不同）。
# 从模型失败时自动回退主模型。llm.scenario_routing: 场景 → 主/从（via），
# 未配置的场景按内置默认（轻量场景走从：reflector_l3 / session_triage /
# daily_summary / conversation_summary / relationship_eval /
# relationship_narrative；主决策与质量敏感场景走主）。
# max_tokens 仅工具循环类路径生效；摘要类走从模型自身 max_tokens。
# 场景键拼错会被配置 API 400 拦截，文件直改会在构建期告警；
# via 拼错则整个 yaml 解析失败（fail-fast，agent 拒绝启动）。
# 工具循环（think 的 tool loop）随 think 场景整链路由，轮次不单独分流。
#
# llm_secondary:
#   provider: openai_compatible
#   base_url: https://api.minimaxi.com/v1
#   api_key: sk-xxx                    # 同 Provider 可复用主模型密钥
#   model: MiniMax-M2.7
#   max_tokens: 1024
# llm:
#   scenario_routing:
#     conversation_summary:
#       via: secondary
#       max_tokens: 512
#     think:
#       via: primary
