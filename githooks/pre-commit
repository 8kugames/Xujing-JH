# ============================================================================
# pre-commit: 版本号控制 + 质量前置检查
#   · 暂存区含 .rs 变更时, 对暂存文件原地 rustfmt --check（只读不改写）, 失败即中止
#   · clippy 不在本地校验(需整体编译上下文, 无法按单文件运行), 交由 CI 强制
#   · 设计红线: 本钩子禁止 stash/restore/checkout 等改写工作树状态的操作——
#     工作树是多会话并行共享的公共现场, 对其他 session 的未暂存改动必须零触碰
#   · 版本双轨制:
#     · crate 轨(本钩子职责): 暂存区含 crates/<crate>/ 的 .rs/.toml/.yaml 变更时,
#       该 crate 版本 patch +1, 并同步依赖方 Cargo.toml 中的 path 依赖版本引用
#     · 发版轨(本钩子零触碰): 仓库根 ./Version 是项目发版版本, 仅由发版流程推进
#       (.agents/skills/release/SKILL.md), 发版 tag v<VER> 以它为唯一读数源
#   · 同步刷新 Cargo.lock (cargo update -w)，按 untrack 决策(f0834eb7)仅本地维护，不入库
#   · 被修改的 Cargo.toml 自动 git add 并入本次 commit
#   · 无相关变更时直接放行
# 依赖: perl (跨平台行内替换, 规避 BSD/GNU sed -i 差异), cargo (刷新 Cargo.lock)
# 激活: git config core.hooksPath githooks
# 跳过: git commit --no-verify
# ============================================================================
set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v perl > /dev/null 2>&1; then
    echo "[pre-commit] ✗ 未找到 perl, 无法同步依赖版本, 中止" >&2
    exit 1
fi

if ! command -v cargo > /dev/null 2>&1; then
    echo "[pre-commit] ✗ 未找到 cargo, 无法同步 Cargo.lock, 中止" >&2
    exit 1
fi

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Workspace 全部成员 crate
CRATES=("agent" "embedding" "protocol" "server")

# --- 判断某 crate 暂存区是否含 .rs/.toml/.yaml 变更 ---
has_staged_changes() {
    local staged_files
    staged_files=$(git diff --cached --name-only "crates/$1" 2>/dev/null | grep -E '\.(rs|toml|yaml)$' || true)
    [ -n "$staged_files" ]
}

# --- 从 Cargo.toml 提取当前版本 ---
get_current_version() {
    grep -E '^version[[:space:]]*=' "$1" | sed -E 's/.*"([0-9]+\.[0-9]+\.[0-9]+)".*/\1/'
}

# --- patch 段 +1 (10# 强制十进制, 防前导零被当八进制) ---
bump_version() {
    local major minor patch
    major=$(echo "$1" | cut -d. -f1)
    minor=$(echo "$1" | cut -d. -f2)
    patch=$(echo "$1" | cut -d. -f3)
    echo "${major}.${minor}.$((10#$patch + 1))"
}

# --- 写回版本行 (macOS/BSD 与 GNU sed -i 参数不同) ---
update_version_in_file() {
    local cargo_file=$1
    local new_version=$2
    if [[ "$OSTYPE" == "darwin"* ]]; then
        sed -i '' "s/^version[[:space:]]*=.*$/version = \"$new_version\"/" "$cargo_file"
    else
        sed -i "s/^version[[:space:]]*=.*$/version = \"$new_version\"/" "$cargo_file"
    fi
}

# --- 同步依赖方 Cargo.toml 中的 path 依赖版本 (兼容 version/path 两种字段顺序) ---
update_dependencies() {
    local updated_crate=$1
    local new_version=$2
    local package_name="cyber-jianghu-$updated_crate"

    for crate in "${CRATES[@]}"; do
        if [ "$crate" = "$updated_crate" ]; then
            continue
        fi

        local cargo_file="crates/$crate/Cargo.toml"
        if [ ! -f "$cargo_file" ]; then
            continue
        fi

        # 仅处理指向被 bump crate 的 path 依赖
        if ! grep -q "$package_name.*path.*\.\./$updated_crate" "$cargo_file"; then
            continue
        fi

        echo -e "  ${BLUE}→${NC} Updating dependency in $crate"

        # 先移除该依赖行上的全部 version 字段, 再在 { 后补写新版本
        perl -i -pe '
            if (/\Q'"$package_name"'\E\s*=\s*\{/) {
                s/,?\s*version\s*=\s*"[0-9]+\.[0-9]+\.[0-9]+"//g;
                s/=\s*\{, /= { /g;
                s/,\s*\}/ }/g;
            }
        ' "$cargo_file"
        perl -i -pe "s|($package_name\s*=\s*\{)|\1 version = \"$new_version\",|" "$cargo_file"

        echo -e "  ${GREEN}✓${NC} Updated $package_name dependency to $new_version in $crate"
        MODIFIED_FILES+=("$cargo_file")
    done
}

# --- 质量前置检查: 仅校验暂存区对应的 .rs 文件格式 ---
# rustfmt --check 为只读模式, 原地校验不改写文件, 无需临时目录。
# 校验对象是暂存文件在工作树的当前内容（常规流程下与暂存内容一致；
# 若暂存后又改动, 以工作树为准, 残留问题由 CI fmt 门禁兑底）。
# skip_children 禁止 rustfmt 顺着 mod 声明解析兄弟文件（暂存区可能只含部分文件）。
# 放在版本 bump 之前: 检查失败立即中止, 不产生任何 bump/git add 副作用
STAGED_RS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.rs$' || true)
if [ -n "$STAGED_RS" ]; then
    if ! command -v rustfmt > /dev/null 2>&1; then
        echo -e "${YELLOW}⚠${NC} 未找到 rustfmt, 跳过 fmt 校验（CI 仍会强制）" >&2
    else
        RUST_EDITION=$(grep -m1 -E '^edition' crates/server/Cargo.toml | sed -E 's/.*"(.*)".*/\1/')
        case "$RUST_EDITION" in 2015 | 2018 | 2021 | 2024) ;; *) RUST_EDITION=2021 ;; esac

        echo -e "${BLUE}→${NC} rustfmt --check (原地只读; clippy 交由 CI)"
        FMT_FAIL=0
        for f in $STAGED_RS; do
            if [ ! -f "$f" ]; then
                echo -e "${YELLOW}⚠${NC} 跳过 $f（工作树中不存在）" >&2
                continue
            fi
            if ! rustfmt --check --edition "$RUST_EDITION" --config skip_children=true "$f"; then
                FMT_FAIL=1
            fi
        done

        if [ "$FMT_FAIL" -ne 0 ]; then
            echo -e "${RED}✗${NC} fmt 未通过，请执行 cargo fmt 后重新暂存提交" >&2
            exit 1
        fi
        echo -e "${GREEN}✓${NC} fmt 通过"
    fi
fi

MODIFIED_FILES=()

for crate in "${CRATES[@]}"; do
    cargo_file="crates/$crate/Cargo.toml"

    if [ ! -f "$cargo_file" ]; then
        echo -e "${YELLOW}⚠${NC} Crate $crate not found at $cargo_file"
        continue
    fi

    if ! has_staged_changes "$crate"; then
        continue
    fi

    current_version=$(get_current_version "$cargo_file")
    if [ -z "$current_version" ]; then
        echo -e "[pre-commit] ✗ $cargo_file 含暂存变更但无法解析 version 行, 中止" >&2
        exit 1
    fi

    new_version=$(bump_version "$current_version")
    update_version_in_file "$cargo_file" "$new_version"
    MODIFIED_FILES+=("$cargo_file")

    echo -e "  ${GREEN}✓${NC} $crate: $current_version → $new_version"
    update_dependencies "$crate" "$new_version"
done

# 版本文件自动并入本次 commit。
# Cargo.lock 的处理刻意与 Cargo.toml 分开表述，避免误读：
#   · Cargo.toml（版本提升）      → git add 并入本次 commit
#   · Cargo.lock（依赖锁定文件）  → 仅刷新工作树本地文件，按 untrack 决策永不入库
if [ ${#MODIFIED_FILES[@]} -gt 0 ]; then
    # 静默执行：cargo 自带的 "Locking/Updating ..." 输出无前缀，
    # 易被误读为入库动作，故吞掉后由钩子自行播报
    if cargo update -w > /dev/null 2>&1; then
        echo -e "  ${BLUE}→${NC} Cargo.lock 已刷新（仅本地维护，不入库 —— untrack 决策）"
    else
        echo -e "${YELLOW}⚠${NC} cargo update -w 失败，Cargo.lock 未刷新（不影响本次 commit，可稍后手动执行）"
    fi

    git add "${MODIFIED_FILES[@]}"

    echo "[pre-commit] 以下 Cargo.toml（版本提升）已并入本次 commit:"
    printf '    %s\n' "${MODIFIED_FILES[@]}" | sort -u
    echo "[pre-commit] Cargo.lock 不入库：仅工作树本地刷新；实际入库内容以 git show HEAD 为准"
fi
